# Copy to .env and fill in. .env is git-ignored.

POSTGRES_USER=logbook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=logbook

# openssl rand -base64 48
SESSION_SECRET=change-me

# The first admin, created on first boot. It is forced to change this
# password at first sign-in.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-too

# The port your existing reverse proxy should point at.
APP_PORT=3000

# Behind a proxy that terminates TLS. Set COOKIE_SECURE=false only if you
# are serving plain HTTP on a trusted LAN.
TRUST_PROXY=true
COOKIE_SECURE=true

MAX_UPLOAD_MB=32
TZ=America/New_York

# Which published image to run. `latest` follows every release; set a
# version (1.2.3) or build (sha-abc1234) to pin, then `docker compose up -d`.
IMAGE_TAG=latest

# Seconds between watchtower's checks for a new release.
WATCHTOWER_POLL_INTERVAL=300
